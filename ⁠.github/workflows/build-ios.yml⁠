name: Build iOS App
on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build-ios:
    name: Compile and Build IPA
    runs-on: macos-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Xcode Version
        run: |
          sudo xcode-select -s /Applications/Xcode.app
          xcodebuild -version

      - name: Build and Archive Project
        run: |
          # ជំនួស YourProject.xcodeproj និង YourScheme ជាមួយឈ្មោះ Project របស់អ្នកពិតប្រាកដ
          xcodebuild -project YourProject.xcodeproj \
                     -scheme YourScheme \
                     -sdk iphoneos \
                     -configuration Release \
                     -archivePath build/YourApp.xcarchive \
                     archive

      - name: Export to IPA
        run: |
          # ត្រូវធានាថាអ្នកមាន ExportOptions.plist ត្រឹមត្រូវសម្រាប់ការ Sign វិញ្ញាបនបត្រ
          xcodebuild -exportArchive \
                     -archivePath build/YourApp.xcarchive \
                     -exportPath build/ipa \
                     -exportOptionsPlist ExportOptions.plist

      - name: Upload Generated IPA Artifact
        uses: actions/upload-artifact@v4
        with:
          name: iOS-Release-IPA
          path: build/ipa/*.ipa
